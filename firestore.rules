rules_version = '2';
// 각 사용자는 자기 문서(users/{uid} 와 하위 컬렉션)만 읽고 쓸 수 있다. 그 외 모든 경로는 차단.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // 콜사인 중복 방지: 누구나 '존재 여부(get)'만 확인 가능, 생성은 본인 uid 로 1회만(이미 있으면 create 불가), 수정 불가
    // 삭제는 계정 삭제 시 본인 콜사인만 가능 (콜사인 해제)
    match /nicks/{key} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'nick']);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
